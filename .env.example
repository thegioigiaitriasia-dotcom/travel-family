# ==========================================
# CÁC BIẾN MÔI TRƯỜNG DỰ ÁN TRAVEL-FAMILY
# ==========================================
# Hãy copy file này thành `.env` (không có đuôi .example) và điền các khóa của bạn vào.
# Trên Vercel, hãy copy tất cả các biến này vào phần Settings > Environment Variables.

# ------------------------------------------
# 1. Cấu hình Supabase (BẮT BUỘC)
# ------------------------------------------
# URL dự án Supabase (Ví dụ: https://tcpbxxwcljnuxwprfwvm.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Khóa ẩn danh (Anon Key) của Supabase để Frontend gọi API
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Khóa quản trị Backend Supabase (Service Role Key)
# RẤT QUAN TRỌNG: Cần thiết để tạo tài khoản phụ (Sub-account) trên server
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------
# 2. Cấu hình Trí Tuệ Nhân Tạo (BẮT BUỘC)
# ------------------------------------------
# Google Gemini AI Key (Dùng để Tự động tạo lịch trình & Nhận diện giọng nói nhật ký)
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------
# 3. Cấu hình Bản đồ & Địa điểm (KHUYÊN DÙNG)
# ------------------------------------------
# Google Maps/Places API Key (Dùng để hiển thị Bản đồ và lấy ảnh thật, địa chỉ thật từ Google Places)
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ------------------------------------------
# 4. Cấu hình Thanh toán SePay (BẮT BUỘC ĐỂ AUTO-UPGRADE)
# ------------------------------------------
# Mã Ngân Hàng (Tên viết tắt, VD: MB, VCB, ACB...)
VITE_SEPAY_BANK="TPB"

# Số Tài Khoản Ngân Hàng nhận tiền
VITE_SEPAY_ACCOUNT="00003554020"

# API Secret Key của SePay (lấy trong trang quản trị webhook của SePay)
# Dùng để xác thực chữ ký (Signature) tránh bị giả mạo request
VITE_SEPAY_SECRET_KEY="your_sepay_secret_key"

# ------------------------------------------
# 5. Các biến môi trường khác (Tùy chọn)
# ------------------------------------------
# Môi trường chạy (development, production)
NODE_ENV="development"

# URL của website (để tạo các link nội bộ, ví dụ: https://giadinhvivu.com)
APP_URL="http://localhost:3000"
